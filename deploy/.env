# === АДМИНИСТРИРОВАНИЕ NEXTCLOUD ===
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=super_secure_password

# === ДОСТУП К NEXTCLOUD ===
# Внутренний (для Docker-сети – используется контейнером cli)
CLI_NEXTCLOUD_URL=http://nginx-server

# Внешний (для браузера – используется конечными пользователями)
NEXTCLOUD_HOSTNAME=nextcloud.localhost
NEXTCLOUD_PORT=8080

# === БЕЗОПАСНОСТЬ ===
NEXTCLOUD_TRUSTED_PROXIES=["172.28.0.0/16"]
JWT_SECRET=very_secret_jwt_key

# === БАЗА ДАННЫХ ===
# ПРЕДУПРЕЖДЕНИЕ: Изменение этих параметров ПОСЛЕ первоначального развёртывания
# потребует согласования с томами и приведёт к потере данных.
# Меняйте только при первом развёртывании.
POSTGRES_DB=nextcloud
POSTGRES_USER=nextclouduser
POSTGRES_PASSWORD=strongdbpassword

# === ЛОКАЛИЗАЦИЯ ===
TZ=Europe/Moscow

# === НАСТРОЙКА CRON-ВОРКЕРА ===
# Интервал выполнения cron.php Nextcloud (в секундах)
# - 60-120: агрессивное индексирование, большая нагрузка на БД
# - 300-600: рекомендуется для production
# - 1800+: сниженная нагрузка, но замедленная синхронизация
CRON_INTERVAL=300

# Интервал синхронизации фоновых задач Forms (в секундах)
# - 5-10: высокая актуальность, большая нагрузка
# - 20-30: сбалансированный подход
# - 60+: минимальная нагрузка, отложенные обновления
SYNC_INTERVAL=10