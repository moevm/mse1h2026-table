NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=super_secure_password

NEXTCLOUD_HOSTNAME=nextcloud.localhost # внешний адрес без http(s)://
NEXTCLOUD_TRUSTED_PROXIES=["172.28.0.0/16"] # CIDR JSON-массив сетей прокси; одна из них должна совпадать с subnet в docker-compose.yml

NEXTCLOUD_PORT=8080

TZ=Europe/Moscow

JWT_SECRET=very_secret_jwt_key

POSTGRES_DB=nextcloud
POSTGRES_USER=nextclouduser
POSTGRES_PASSWORD=strongdbpassword
