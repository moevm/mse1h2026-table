NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=super_secure_password

NEXTCLOUD_URL=http://nextcloud.localhost:8080
NEXTCLOUD_HOSTNAME=nextcloud.localhost # должен совпадать с host-частью NEXTCLOUD_URL; используется в extra_hosts onlyoffice-document-server
NEXTCLOUD_TRUSTED_PROXIES=["172.28.0.0/16"] # должно совпадать с networks.default.ipam.config.subnet в docker-compose.yml

NEXTCLOUD_PORT=8080

TZ=Europe/Moscow

JWT_SECRET=very_secret_jwt_key

POSTGRES_DB=nextcloud
POSTGRES_USER=nextclouduser
POSTGRES_PASSWORD=strongdbpassword
